# Copy to .env (git-ignored), fill in, then run:  node tools/write-supabase-config.mjs
# Values come from Supabase Dashboard → Project Settings → API.
#
# Only the PUBLISHABLE (anon) key goes here. It is designed to be used in browsers;
# Row Level Security protects the data. NEVER put the secret / service_role key in this project.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional: show the "Explain in plain words (AI)" button in the Character Guide.
# Needs the Supabase Edge Function supabase/functions/character-guide-ai deployed, with its
# Gemini key stored as a Supabase secret (never here):  supabase secrets set GEMINI_API_KEY=...
FOG_AI_GUIDE=false

# Optional: show the Buy buttons (plans on the Upgrade page, the campaign book in the Logbook).
# Needs the Edge Functions payments-checkout and payments-webhook deployed and their secrets set (see README → Payments).
# Payment secrets (Lemon Squeezy API key, webhook secret) are Supabase secrets, never put here.
FOG_PAYMENTS=false

# Optional (development / demo only): show sample billing data from a MOCK Lemon Squeezy store on Dashboard → Billing.
# It is labelled as demo everywhere, never contacts Lemon Squeezy, never charges anyone and never unlocks anything.
FOG_DEMO_BILLING=false
# Your own user id (Supabase → Authentication → Users) to also see the demo Revenue view (#billing/revenue).
FOG_DEMO_BILLING_OWNER=
